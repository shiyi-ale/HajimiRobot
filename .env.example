# Server-side only. Do not use a VITE_ prefix for secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
REPORT_TIMEZONE=Asia/Shanghai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# local = CPU ONNX embeddings; api = compatible remote embedding service.
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_THREADS=2
# Download once, then set 1 to prohibit model downloads at runtime.
LOCAL_EMBEDDING_OFFLINE=0
# Minimum daily observation coverage for semantic retrieval.
MEMORY_MIN_COVERAGE=0.5
# Empty URL uses persistent local Qdrant, without Docker.
QDRANT_URL=
QDRANT_API_KEY=
# Set the same token in Web-Console/.env.local before any non-loopback ingress.
HAJIMI_API_TOKEN=
# Optional: HAJIMI_DATA_DIR, FFMPEG_EXE
