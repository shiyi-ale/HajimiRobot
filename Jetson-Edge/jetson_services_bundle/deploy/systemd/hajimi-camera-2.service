[Unit]
Description=Hajimi Camera 2 MJPEG Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zhj/Hajimi
Environment=CAMERA_HOST=0.0.0.0
Environment=CAMERA_PORT=5001
Environment=CAMERA_DEVICE=/dev/v4l/by-id/usb-058f_HBVCAM_CAMERA-video-index0
Environment=CAMERA_WIDTH=640
Environment=CAMERA_HEIGHT=480
Environment=CAMERA_FPS=25
Environment=CAMERA_JPEG_QUALITY=30
ExecStart=/usr/bin/python3 /home/zhj/Hajimi/camera_http_stream.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
